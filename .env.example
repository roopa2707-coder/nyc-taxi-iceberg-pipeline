# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- what to process
TRIP_YEAR=2025
TRIP_MONTH=1

# --- catalog: polaris (preferred) | glue (fallback) | local (offline dry run, no AWS)
CATALOG_BACKEND=polaris
ICEBERG_NAMESPACE=taxi

# --- AWS: access key of the least-privilege IAM user "taxi-pipeline" (NOT root)
AWS_REGION=us-east-1
S3_BUCKET=your-name-nyc-taxi-pipeline
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Polaris (local Docker)
POLARIS_URI=http://localhost:8181/api/catalog
POLARIS_CATALOG=taxi_catalog
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=change-me-local-only
POLARIS_S3_ROLE_ARN=arn:aws:iam::123456789012:role/taxi-snowflake-read

# --- Snowflake (only for scripts/export_snowflake_results.py)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
